# --- Discord ---------------------------------------------------------------
# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Server (guild) ID: right-click the server with Developer Mode on -> Copy Server ID
GUILD_ID=
# Role pinged by rehearsal polls (e.g. "Final Bossa Member")
MEMBER_ROLE_ID=
# Optional: role allowed to run admin commands. Blank = anyone with Manage Server.
ADMIN_ROLE_ID=

# --- Rehearsal defaults ----------------------------------------------------
TZ=America/Chicago
REHEARSAL_DEFAULT_START=14:00
REHEARSAL_DEFAULT_HOURS=3
POLL_DURATION_HOURS=24
REMINDER_HOURS_BEFORE=48
DAY_OF_REMINDER_TIME=09:00
# If the winning time has fewer votes than this, Navi DMs the poll creator to confirm it
MIN_TURNOUT=4

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=navi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=navi
# Host port for connecting from your PC (pgAdmin, DBeaver, drizzle studio)
POSTGRES_PORT=5433
# Used by `npm run dev` on your PC. Inside docker compose this is overridden.
DATABASE_URL=postgres://navi:change-me@localhost:5433/navi

# --- Unraid ----------------------------------------------------------------
# Where postgres stores its data on the host.
# Unraid: /mnt/user/appdata/navi/postgres   Dev machine: ./data/postgres
DATA_DIR=./data/postgres
